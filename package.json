{
  "name": "notonawa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "types": "wrangler types",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p public/tsconfig.json",
    "test": "vitest run",
    "test:ui": "node scripts/ui-smoke.mjs",
    "check:changed": "node scripts/check-changed.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:prod": "node scripts/deploy.mjs --prod",
    "deploy:dev": "node scripts/deploy.mjs --dev",
    "check": "npm run lint && npm run typecheck && npm run test && node scripts/privacy-html.mjs --check && node scripts/releases.mjs --check && node scripts/vendor.mjs --check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@panva/hpke-noble": "1.1.8",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "hpke": "1.1.8",
    "mediabunny": "1.61.3",
    "three": "0.186.1",
    "typescript": "^7.0.2",
    "uqr": "0.1.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261109.1": true
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3"
  }
}

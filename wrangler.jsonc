{
	"name": "notonawa",
	"main": "src/index.js",
	"compatibility_date": "2026-10-11",
	// The app is one page (public/index.html): any address that isn't a file
	// gets it, and the page shows the view for the address (or "not found").
	// /api/ always goes to the Worker, so an API 404 stays JSON.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// No stored request logs: they'd keep IP addresses and URLs on Cloudflare.
	// Errors can still be watched live with `npx wrangler tail`.
	"observability": {
		"enabled": false
	},
	// Passkeys are tied to RP_ID (the site's domain) for good: moving to a new
	// domain means everyone adds a new passkey there (with their recovery
	// code). ORIGIN is the site's address; writes from anywhere else are
	// refused. Local values are in .dev.vars.
	// BACKUP_PUBLIC_KEY: the public half of the backup key pair (made with
	// `node scripts/backup-keys.mjs`), as one line of JSON. Public, so it can
	// live here; the private half never comes near Cloudflare. Empty: no
	// daily backups.
	"vars": {
		"RP_ID": "notonawa.app",
		"ORIGIN": "https://notonawa.app",
		// The format new sign-ups start in (src/format.js): 1 until phase 7 of
		// the encrypt-everything migration.
		"NEW_ACCOUNT_FORMAT": "1",
		"BACKUP_PUBLIC_KEY": "{\"kty\":\"RSA\",\"n\":\"qGsQ_D7k1QLxoQga1_y1UmYrUmxBgmNNnwsZOOU_cmRKbJnVAfLDnG18FrJmLcDZLxYJfKAMMvFQak-jtLeuFhUNivF0afwbtqVNWGrvkjSp9V_vuG0LY128ve7Tiv0zbiHWrBKKO0X8dN9w3kVd2tc_BFnLFZnOnHa2fOceRru5XSeaXmMKY0hhQHhP-IT9jIv1ynrdDruj3rWmFcM7RGi7O6vYg7GstcLRmgvihoupwfjsnz_jeDNRvYNA0lZwVeGyBEnfqvmjCA_KHWblk-gHxH0_N75ekcB8x4uRBBJST7vz2ycP1Xy8z68Cha43z4BjinlcwwuANIbkUSNvZKXD47wzKE1cJYVNi1NwqCbTstMuM8xRbG2Oe5RdN1MM9CJR2YOpgbgPUfxRzqRxwx3QaOgSdv7aJANBt6fSB7myMLc4EPP8Hn22txN7gNWQwB2nQUv570TzhQ3CVyFgkwnyrqr0Oq2qe1E3rI4mq8-APT6eiMTw5tKUqyvkf6nhoK5__4-G6rpN_oQpSdYw_W7ylFpQTAm_s6FbHUn2rTVOUaDazVU7881ddT1dKY15Cpyo76ark_3IRU6fIezw6hiFQbVEo0WRXC75-1Zs0iiFhtNMk_dSeBh8Bq8Zwn3bPGtLqY_0toqWbGYb4NWDIk2RN4gcbIccjzpddvA6L98\",\"e\":\"AQAB\",\"alg\":\"RSA-OAEP-256\",\"ext\":true,\"key_ops\":[\"encrypt\"]}"
	},
	// Sign-in attempts per IP address per minute, shares opened per account
	// per minute (src/shares/), and messages left in contacts' mailboxes per
	// IP address per minute (src/mailboxes/). Counted in memory by
	// Cloudflare; nothing is stored.
	"ratelimits": [
		{
			"name": "AUTH_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "SHARE_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "MAILBOX_RATE_LIMIT",
			"namespace_id": "1005",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	// Once a day: an encrypted backup of the database, deleting ones over 30
	// days old (src/backup/), then delete ended sessions and expired sign-in
	// challenges (src/cleanup.js) and photo files left without a row.
	"triggers": {
		"crons": [
			"17 3 * * *"
		]
	},
	// Photos, encrypted in the browser (src/media/). A private bucket: no
	// public access and no r2.dev address; files are only handed back through
	// the Worker, to their owner. Made with
	// `npx wrangler r2 bucket create notonawa-photos --location enam`.
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "notonawa-photos",
			"remote": true
		},
		// The daily backups, sealed so only the backup private key opens
		// them. Private like the photos. Made with
		// `npx wrangler r2 bucket create notonawa-backups --location enam`.
		{
			"binding": "BACKUPS",
			"bucket_name": "notonawa-backups",
			"remote": true
		}
	],
	// Emails us when a bug report or idea is sent from the app
	// (src/feedback/notify.js). Only to this address, which is verified in
	// Email Routing for notonawa.app.
	"send_email": [
		{
			"name": "FEEDBACK_EMAIL",
			"destination_address": "contact@notonawa.app"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "notonawa",
			"database_id": "6649d49d-4f4a-4974-8514-61867c68be49",
			"remote": true
		}
	],
	// The app lives only on its own domain; the workers.dev address is off.
	"routes": [
		{
			"pattern": "notonawa.app",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	// `npm run dev` would otherwise take its host from the route above and
	// rewrite each request's Origin to https://notonawa.app, which the Origin
	// check refuses. Must match ORIGIN in .dev.vars.
	"dev": {
		"host": "localhost:8787",
		"port": 8787
	},
	// A separate copy of the app for testing before production, at
	// dev.notonawa.app, with its own database and photos bucket: nothing
	// here touches the real journal. Deploy with
	// `npx wrangler deploy --env dev`. Bindings and vars aren't inherited
	// from the top level, so every one it needs is listed here; routes would
	// be, so it has its own (otherwise it would claim notonawa.app).
	// No backups (BACKUP_PUBLIC_KEY is empty, so the daily job skips them)
	// and no feedback emails (without FEEDBACK_EMAIL, nothing is sent).
	// `npm run dev` runs this environment on localhost (RP_ID and ORIGIN from
	// .dev.vars) with its remote database and photos bucket, so local work
	// never touches the real journal. Passkeys made there work only on
	// localhost, and new code needs its migrations applied here first.
	"env": {
		"dev": {
			"name": "notonawa-dev",
			"routes": [
				{
					"pattern": "dev.notonawa.app",
					"custom_domain": true
				}
			],
			// Passkeys made here only work here.
			"vars": {
				"RP_ID": "dev.notonawa.app",
				"ORIGIN": "https://dev.notonawa.app",
				// 2 once the format 2 store is built (phase 4).
				"NEW_ACCOUNT_FORMAT": "1",
				"BACKUP_PUBLIC_KEY": ""
			},
			"ratelimits": [
				{
					"name": "AUTH_RATE_LIMIT",
					"namespace_id": "1002",
					"simple": {
						"limit": 20,
						"period": 60
					}
				},
				{
					"name": "SHARE_RATE_LIMIT",
					"namespace_id": "1004",
					"simple": {
						"limit": 30,
						"period": 60
					}
				},
				{
					"name": "MAILBOX_RATE_LIMIT",
					"namespace_id": "1006",
					"simple": {
						"limit": 60,
						"period": 60
					}
				}
			],
			"r2_buckets": [
				{
					"binding": "PHOTOS",
					"bucket_name": "notonawa-photos-dev",
					"remote": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "notonawa-dev",
					"database_id": "da883076-6cad-4ef2-9bfe-59143e5256a6",
					"remote": true
				}
			]
		}
	}
}
# Security headers for the static files in public/, which are served without
# running the Worker. The Worker adds the same headers (except this CSP) to its
# own responses in src/security-headers.js; keep the shared ones in step.
#
# CSP: only our own scripts, styles and requests. No inline scripts or styles,
# no eval, no plugins, no <base>, and no embedding in other sites. Trusted
# Types means the browser refuses innerHTML and similar string-to-HTML calls
# outright (we never use them; see dom.js). Its one policy, crypto-worker,
# lets through only the crypto Worker's URL (vault.js), which worker-src
# 'self' allows to start. img-src blob: shows photos decrypted on the
# device (photo-urls.js), and media-src blob: plays videos decrypted there;
# nothing else makes blob: URLs for images or videos. (The video library,
# public/js/vendor/mediabunny.js, can start Workers from blob: URLs for
# features we don't use; worker-src 'self' refuses them.)
# manifest-src 'self' lets phones add the app to the home screen
# (manifest.webmanifest).
#
# no-store on everything first (the page, privacy.html, the manifest),
# which keeps the page out of the back/forward cache. The blocks after the
# first replace it for the app's code and images, which hold none of the
# journal: with no build step, a view's code is a chain of small files, each
# waiting on the one that imports it, and fetching them all afresh on every
# page load made views slow to open.
/*
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; media-src blob:; manifest-src 'self'; connect-src 'self'; worker-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types crypto-worker
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# The code and styles: kept, but checked with the server before each use
# (a tiny "not modified" when unchanged), so a deploy is never missed.
/js/*
  ! Cache-Control
  Cache-Control: no-cache

/app.css
  ! Cache-Control
  Cache-Control: no-cache

# Images: kept for a week without asking. A changed image needs a new file
# name, or devices keep the old one until then.
/img/*
  ! Cache-Control
  Cache-Control: max-age=604800

# The poser's body (about 2 MB): kept a week, like images, as it's fetched
# whenever the poser opens. A changed body needs a new file name
# (scripts/figure/pack_body.py, BIN).
/figure/*
  ! Cache-Control
  Cache-Control: max-age=604800

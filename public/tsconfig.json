{
  // Type checks the browser pages' scripts from JSDoc comments.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // Untyped parameters are allowed for now; add JSDoc types as code is touched.
    "noImplicitAny": false,
    "types": [],
    "skipLibCheck": true
  },
  "include": ["**/*.js"],
  // Copied libraries (scripts/vendor.mjs): their .d.ts files are used instead.
  "exclude": ["js/vendor/**"]
}
